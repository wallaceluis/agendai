# Banco Postgres (Neon, Supabase ou Vercel Postgres)
DATABASE_URL="postgresql://usuario:senha@host:5432/agendai?sslmode=require"
# Conexão direta para migrations (no Neon é a URL sem "-pooler"; senão repita a DATABASE_URL)
DIRECT_URL="postgresql://usuario:senha@host:5432/agendai?sslmode=require"

# Segredo da sessão: gere com `openssl rand -base64 32`
AUTH_SECRET=""

# URL pública do app (sem barra no final)
NEXT_PUBLIC_APP_URL="https://agendai.vercel.app"

# Assinatura mensal
PLAN_PRICE="39.90"
TRIAL_DAYS="14"

# Mercado Pago (Assinaturas / preapproval). Sem essas chaves o checkout fica desativado.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Fuso horário dos estabelecimentos, em minutos em relação ao UTC (Brasília = -180)
TZ_OFFSET_MINUTES="-180"
